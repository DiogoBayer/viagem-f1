rules_version = '2';

// Regras do Interlagos 2026.
// Os gastos ficam em viagens/interlagos-2026/gastos.
// Qualquer pessoa com o link do site pode ler, lançar, editar e apagar gastos.
// A posição ao vivo fica em viagens/interlagos-2026/aovivo (documentos "posicao" e "trilha").
// Qualquer pessoa com o link do site pode ler, gravar e apagar a posição.
// As regras só barram dados malformados e qualquer outro lugar do banco.
service cloud.firestore {
  match /databases/{database}/documents {

    function gastoValido(d) {
      return d.keys().hasOnly(['descricao', 'valor', 'categoria', 'pagoPor', 'divididoEntre', 'criadoEm', 'quitados'])
        && (!('quitados' in d) || (d.quitados is list && d.quitados.size() <= 4))
        && d.keys().hasAll(['descricao', 'valor', 'categoria', 'pagoPor', 'divididoEntre', 'criadoEm'])
        && d.descricao is string && d.descricao.size() > 0 && d.descricao.size() <= 80
        && d.valor is int && d.valor > 0 && d.valor <= 10000000
        && d.categoria is string && d.categoria.size() <= 30
        && d.pagoPor in ['', 'Diogo', 'Antonio', 'João Vitor', 'Augusto']
        && d.divididoEntre is list && d.divididoEntre.size() >= 1 && d.divididoEntre.size() <= 4
        && d.criadoEm is string && d.criadoEm.size() <= 40;
    }

    match /viagens/{viagem}/gastos/{gastoId} {
      allow read, delete: if viagem == 'interlagos-2026';
      allow create, update: if viagem == 'interlagos-2026' && gastoValido(request.resource.data);
    }

    function posicaoValida(d) {
      return d.keys().hasOnly(['lat', 'lng', 'precisao', 'vel', 'por', 'em'])
        && d.keys().hasAll(['lat', 'lng', 'precisao', 'vel', 'por', 'em'])
        && d.lat is number && d.lat >= -90 && d.lat <= 90
        && d.lng is number && d.lng >= -180 && d.lng <= 180
        && d.precisao is number && d.precisao >= 0
        && d.vel is number && d.vel >= -1 && d.vel <= 400
        && d.por in ['Diogo', 'Antonio', 'João Vitor', 'Augusto']
        && d.em is string && d.em.size() <= 40;
    }

    function trilhaValida(d) {
      return d.keys().hasOnly(['pontos'])
        && d.pontos is list && d.pontos.size() <= 4000;
    }

    match /viagens/{viagem}/aovivo/{docId} {
      allow read, delete: if viagem == 'interlagos-2026' && docId in ['posicao', 'trilha'];
      allow create, update: if viagem == 'interlagos-2026'
        && ((docId == 'posicao' && posicaoValida(request.resource.data))
          || (docId == 'trilha' && trilhaValida(request.resource.data)));
    }
  }
}
